            "url": "{{baseUrl}}/iot/v2/devices/:id/certs/:cid",
            "headers": [
              {
                "name": "X-Organization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cid",
                "value": "",
                "type": "path",
                "description": "The id of the cert"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the device"
