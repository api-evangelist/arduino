          "name": "batch_ingest usage_internal",
          "request": {
            "name": "batch_ingest usage_internal",
            "description": {
              "content": "Upserts a batch of per-(owner, thing, device, date) message counters. The payload carries two flat lists, users_usage and orgs_usage, that can be populated independently in the same request. Rows in users_usage must be unique by (user_id, thing_id, device_id, date). Rows in orgs_usage must be unique by (org_id, thing_id, device_id, date). Duplicate rows are rejected with 400 Bad Request. Behavior is all-or-nothing: every record is committed in a single transaction, or nothing is. On success the endpoint returns 204 No Content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "iot",
                "v1",
                "usage",
                "batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/vnd.goa.error+json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "orgs_usage",
                  "value": "{\"org_id\":\"<uuid>\",\"thing_id\":\"<uuid>\",\"device_id\":\"<uuid>\",\"date\":\"<dateTime>\",\"count\":\"<integer>\"}",
                  "description": "Per-organization counters. Composite key (org_id, thing_id, device_id, date) must be unique within this array."
                },
                {
                  "disabled": false,
                  "key": "orgs_usage",
                  "value": "{\"org_id\":\"<uuid>\",\"thing_id\":\"<uuid>\",\"device_id\":\"<uuid>\",\"date\":\"<dateTime>\",\"count\":\"<integer>\"}",
                  "description": "Per-organization counters. Composite key (org_id, thing_id, device_id, date) must be unique within this array."
